<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D0C1D"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LV.1"
            android:textColor="#070711"
            android:background="#F5C542"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textStyle="bold"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_streak"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingLeft="8dp"
            android:text="🔥 0d · 0 G"
            android:textColor="#E2E8F0"
            android:textStyle="bold"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_remaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 due"
            android:textColor="#FF3B5C"
            android:textStyle="bold"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_top_task"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="Tap to open STATUS"
        android:textColor="#CBD5E1"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_btn_task"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="#7C6DF7"
            android:text="+ TASK"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="11sp" />

        <Button
            android:id="@+id/widget_btn_focus"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="#F5C542"
            android:text="⏱ FOCUS"
            android:textColor="#070711"
            android:textStyle="bold"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
